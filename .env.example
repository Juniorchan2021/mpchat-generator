# ====================================================
# MPChat 智能软文生成器 v3.0 — 环境变量配置
# 复制此文件为 .env 并填入真实的 API Key
# ====================================================

# ── AI 服务商（选择其一） ──────────────────────────────

# Google Gemini API Key（推荐，在 aistudio.google.com 获取）
OPENAI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash

# 或者使用 OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# 或者使用 DeepSeek（更便宜）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# ── Pixabay 图片 API（可选，免费） ─────────────────────
# 在 https://pixabay.com/api/docs/ 注册获取
PIXABAY_API_KEY=
