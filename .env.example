# ====================================================
# MPChat 智能软文生成器 v4.1 — 环境变量配置
# 复制此文件为 .env 并填入真实的 API Key
# ====================================================

# ── AI 服务商（选择其一） ──────────────────────────────

# Google Gemini API Key（推荐，在 aistudio.google.com 获取）
OPENAI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash

# 或者使用 OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# 或者使用 DeepSeek（更便宜）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# ── 图片 API（可选） ──────────────────────────────────
# Pixabay 为主图源，Pexels 为补充，Placewise CDN 为兜底
# 在 https://pixabay.com/api/docs/ 注册获取
PIXABAY_API_KEY=
# 在 https://www.pexels.com/api/key/ 注册获取
PEXELS_API_KEY=

# ── 多平台分发（可选） ─────────────────────────────────

# Dev.to API Key — 从 dev.to/settings/extensions 获取
DEVTO_API_KEY=

# Hashnode — 从 hashnode.com/settings/developer 获取
HASHNODE_TOKEN=
HASHNODE_PUB_ID=
