# ====================================================
# MPChat 智能软文生成器 v4.1 — 环境变量配置
# 复制此文件为 .env 并填入真实的 API Key
# ====================================================

# ── AI 服务商（选择其一） ──────────────────────────────

# Google Gemini API Key（推荐，在 aistudio.google.com 获取）
OPENAI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash

# 或者使用 OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# 或者使用 DeepSeek（更便宜）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# ── 图片 API（可选） ──────────────────────────────────
# Pixabay 为主图源，Pexels 为补充，Placewise CDN 为兜底
# 在 https://pixabay.com/api/docs/ 注册获取
PIXABAY_API_KEY=
# 在 https://www.pexels.com/api/key/ 注册获取
PEXELS_API_KEY=

# ── 多平台分发（可选） ─────────────────────────────────

# Dev.to API Key — 从 dev.to/settings/extensions 获取
DEVTO_API_KEY=

# Hashnode — 从 hashnode.com/settings/developer 获取
HASHNODE_TOKEN=
HASHNODE_PUB_ID=

# Medium — 从 medium.com/me/settings 获取 Integration Token
MEDIUM_TOKEN=

# Paragraph.xyz — 从 paragraph.xyz 账户设置中获取 API Key
PARAGRAPH_API_KEY=

# Intercom — 从 app.intercom.com/a/apps/_/settings/access-tokens 获取
INTERCOM_TOKEN=

# ── MPChat API（v5） ───────────────────────────────────
# 生产环境建议配置，用于保护 FastAPI 接口
MPCHAT_API_KEY=

# 允许跨域来源，多个域名用英文逗号分隔
# 例如：http://localhost:3000,https://your-project.pages.dev
CORS_ALLOW_ORIGINS=http://localhost:3000

# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
LOG_LEVEL=INFO

# ── 前端（frontend/.env.local） ───────────────────────
# Next.js 前端连接后端的地址，本地开发默认 http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
# 与后端 MPCHAT_API_KEY 一致，前端请求时作为 X-API-Key header 发送
NEXT_PUBLIC_API_KEY=
# 前端内置的默认 Gemini API Key（可留空，用户在 UI 中自行输入）
NEXT_PUBLIC_DEFAULT_GEMINI_KEY=
# 前端内置的默认 Kimi (Moonshot) API Key（可留空，用户在 UI 中自行输入）
NEXT_PUBLIC_DEFAULT_KIMI_KEY=
